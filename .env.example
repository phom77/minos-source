# Run python scripts/prepare-docker.py to create a private .env with random passwords.
# Keep the same passwords when reusing an existing database volume.
MINOS_PROJECT_NAME=minos
MINOS_HTTPS_PORT=8443
MINOS_POSTGRES_PORT=5433
# Docker Desktop uses group 0. On native Linux, use the socket's group ID.
MINOS_DOCKER_GID=0
MINOS_BOOTSTRAP_PASSWORD=
MINOS_MIGRATOR_PASSWORD=
MINOS_API_PASSWORD=
MINOS_WORKER_PASSWORD=
